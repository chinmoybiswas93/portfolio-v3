---
import SocialLinks from './SocialLinks.astro';

interface Props {
  name: string;
  title: string;
  tagline: string;
  github: string;
  linkedin: string;
  twitter?: string;
  email: string;
  resumeUrl?: string;
}

const { name, title, tagline, github, linkedin, twitter, email, resumeUrl } = Astro.props;
---

<aside class="flex flex-col h-full px-8 py-16 lg:py-24">
  <div>
    <h1 class="name">{name}</h1>
    <p class="job-title">{title}</p>
    <p class="tagline">{tagline}</p>
  </div>

  <nav class="mt-12" aria-label="Page sections">
    <ul class="flex flex-col gap-4">
      <li>
        <a href="#about" class="nav-link">
          <span class="nav-indicator" aria-hidden="true"></span>
          About
        </a>
      </li>
      <li>
        <a href="#experience" class="nav-link">
          <span class="nav-indicator" aria-hidden="true"></span>
          Experience
        </a>
      </li>
      <li>
        <a href="#projects" class="nav-link">
          <span class="nav-indicator" aria-hidden="true"></span>
          Projects
        </a>
      </li>
    </ul>
  </nav>

  <div class="flex-1"></div>

  <div class="flex flex-col gap-4">
    <SocialLinks github={github} linkedin={linkedin} twitter={twitter} email={email} />
    {resumeUrl && (
      <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="resume-link">
        Resume ↗
      </a>
    )}
  </div>
</aside>

<style>
  .name {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }

  .job-title {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }

  .tagline {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    font-weight: 600;
    transition: color 150ms ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-indicator {
    display: block;
    width: 3px;
    height: 1rem;
    background-color: var(--accent);
    border-radius: 1px;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .nav-link:hover .nav-indicator,
  .nav-link[aria-current="true"] .nav-indicator {
    opacity: 1;
  }

  .resume-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    border: 1px solid var(--border);
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    width: fit-content;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .resume-link:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }
</style>
