---
import SocialLinks from './SocialLinks.astro';

interface Props {
  name: string;
  title: string;
  tagline: string;
  github: string;
  linkedin: string;
  twitter?: string;
  email: string;
  resumeUrl?: string;
}

const { name, title, tagline, github, linkedin, twitter, email, resumeUrl } = Astro.props;
---

<aside class="flex flex-col h-full px-8 py-14 lg:py-24">
  <div>
    <h1 class="name">{name}</h1>
    <p class="job-title">{title}</p>
    <p class="tagline">{tagline}</p>
  </div>

  <nav class="mt-12 mb-12" aria-label="Page sections">
    <ul class="flex flex-col gap-4">
      <li>
        <a href="#about" class="nav-link">
          <span class="nav-indicator" aria-hidden="true"></span>
          About
        </a>
      </li>
      <li>
        <a href="#experience" class="nav-link">
          <span class="nav-indicator" aria-hidden="true"></span>
          Experience
        </a>
      </li>
      <li>
        <a href="#projects" class="nav-link">
          <span class="nav-indicator" aria-hidden="true"></span>
          Projects
        </a>
      </li>
    </ul>
  </nav>

  <div class="flex-1"></div>

  <div class="flex flex-col gap-4">
    <SocialLinks github={github} linkedin={linkedin} twitter={twitter} email={email} />
    {resumeUrl && (
      <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="resume-link">
        Resume ↗
      </a>
    )}
  </div>
</aside>

<style>
  .name {
    font-size: 42px;
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1;
    margin: 0 0 0.5rem;
  }

  @media (min-width: 1024px) {
    .name { font-size: 48px; }
  }

  .job-title {
    font-size: 18px;
    font-weight: 500;
    color: var(--text-secondary);
    margin: 0 0 1.5rem;
  }

  @media (min-width: 1024px) {
    .job-title { font-size: 20px; }
  }

  .tagline {
    font-size: 1rem;
    font-weight: 300;
    color: var(--text-secondary);
    margin: 0;
    max-width: 80%;
    line-height: 1.6;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    font-weight: 500;
    text-decoration: none;
    transition: color 300ms ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* Horizontal growing line — matches original ::before pattern */
  .nav-indicator {
    display: block;
    width: 40px;
    height: 1px;
    background-color: var(--text-secondary);
    flex-shrink: 0;
    transition: width 300ms ease, background-color 300ms ease;
  }

  .nav-link:hover .nav-indicator {
    width: 60px;
    background-color: var(--text-primary);
  }

  .nav-link.active .nav-indicator {
    width: 80px;
    background-color: var(--text-primary);
  }

  .resume-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    border: 1px solid var(--border);
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    width: fit-content;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .resume-link:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }
</style>
