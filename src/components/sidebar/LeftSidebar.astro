---
import SocialLinks from './SocialLinks.astro';
import SidebarNav from './SidebarNav.astro';

interface Props {
  name: string;
  title: string;
  tagline: string;
  github: string;
  linkedin: string;
  twitter?: string;
  email: string;
  resumeUrl?: string;
}

const { name, title, tagline, github, linkedin, twitter, email, resumeUrl } = Astro.props;
---

<aside class="flex flex-col h-full px-8 py-14 lg:py-24">
  <div class="mb-6 lg:mb-12">
    <h1 class="name">{name}</h1>
    <p class="job-title">{title}</p>
    <p class="tagline">{tagline}</p>
  </div>

  <SidebarNav />

  <div class="flex-1"></div>

  <div class="flex flex-col gap-4">
    <SocialLinks github={github} linkedin={linkedin} twitter={twitter} email={email} />
    {resumeUrl && (
      <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="resume-link">
        Resume ↗
      </a>
    )}
  </div>
</aside>

<style>
  .name {
    font-size: 42px;
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1;
    margin: 0 0 0.5rem;
  }

  @media (min-width: 1024px) {
    .name { font-size: 48px; }
  }

  .job-title {
    font-size: 18px;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }

  @media (min-width: 1024px) {
    .job-title { font-size: 20px; }
  }

  .tagline {
    font-size: 1rem;
    font-weight: 300;
    color: var(--text-secondary);
    margin: 0;
    max-width: 80%;
    line-height: 1.6;
  }

  .resume-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    border: 1px solid var(--border);
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    width: fit-content;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .resume-link:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }
</style>
